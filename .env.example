# Host folder mounted as the data directory. Must already exist.
DATA_DIR=./data
# Host port for the web UI.
PORT=8080
# User and group the container runs as. Must be able to write to DATA_DIR.
PUID=1000
PGID=1000
# Password for starting or cancelling scrapes and exporting or uploading data on the
# scraper page. Empty disables all of them; scheduled scrapes always run.
ADMIN_TOKEN=
# Where the data comes from. By default it's downloaded from the public Hugging Face dataset
# https://huggingface.co/datasets/LLukas22/wf-riven-data and new days are fetched every hour.
# Set HF_TOKEN too if the dataset is private. Leave empty to use only the local data.
HF_PULL_DATASET=LLukas22/wf-riven-data
# Scrape warframe.market in the background instead. Turns the download above off.
ENABLE_SCRAPER=false
# Per weapon fetch, how many listings that dropped out of the search pages the scraper asks
# warframe.market about, one request each. Unchecked ones stay listed until they expire after
# four days. More checks make the prices fresher but each sweep longer.
VERIFY_MISSING=2
# Upload each finished day of your own scrapes to a Hugging Face dataset. Create the dataset
# first, then set its id (owner/name) and a token with write access to it. Needs
# ENABLE_SCRAPER=true. Leave both empty to disable uploads.
HF_DATASET=
HF_TOKEN=
