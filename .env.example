# Host folder mounted as the data directory. Must already exist.
DATA_DIR=./data
# Host port for the web UI.
PORT=8080
# User and group the container runs as. Must be able to write to DATA_DIR.
PUID=1000
PGID=1000
# Password for starting or cancelling scrapes and exporting or uploading data on the
# scraper page. Empty disables all of them; scheduled scrapes always run.
ADMIN_TOKEN=
# Scrape warframe.market in the background. Off by default: the server then only hosts its data.
ENABLE_SCRAPER=false
# Upload each finished day to a Hugging Face dataset. Create the dataset first, then set its
# id (owner/name) and a token with write access to it. Leave both empty to disable uploads.
HF_DATASET=
HF_TOKEN=
